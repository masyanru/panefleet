{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach to running process",
      "pid": "${command:pickMyProcess}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug PaneFleet",
      "cargo": {
        "args": ["build", "--package", "warp", "--bin", "panefleet"],
        "filter": {
          "name": "panefleet",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug PaneFleet tests",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--package",
          "warp",
          "--bin",
          "panefleet"
        ],
        "filter": {
          "name": "panefleet",
          "kind": "bin"
        }
      },
      "args": ["panefleet"],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    }
  ]
}
